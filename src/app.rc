#include <winres.h>
#include "version.h"

1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
 PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Tamer Barış Ekin"
            VALUE "FileDescription", "Slice75 HE Native"
            VALUE "FileVersion", APP_VERSION_STR
            VALUE "InternalName", "Slice75HE"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "Slice75HE.exe"
            VALUE "ProductName", "Slice75 HE Native"
            VALUE "ProductVersion", APP_VERSION_STR
            VALUE "Comments", "Unofficial configurator, not affiliated with Chilkey. " APP_REPO_URL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
